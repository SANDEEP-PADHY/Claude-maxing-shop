# ──────────────────────────────────────────────
# claudemaxing.shop – Next.js + Prisma .gitignore
# ──────────────────────────────────────────────

# Dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js build output
.next/
out/
build/

# Vercel
.vercel/

# ──────────────────────────────────────────────
# Environment variables
# ──────────────────────────────────────────────
# Track .env.example only – never commit real secrets
.env
.env.*
!.env.example

# ──────────────────────────────────────────────
# Database – local development
# ──────────────────────────────────────────────
*.db
*.db-journal
*.sqlite
*.sqlite3
prisma/dev.db
prisma/dev.db-journal

# ──────────────────────────────────────────────
# Testing & coverage
# ──────────────────────────────────────────────
coverage/
.nyc_output/
test-results/
playwright-report/
blob-report/

# ──────────────────────────────────────────────
# Logs
# ──────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ──────────────────────────────────────────────
# TypeScript
# ──────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ──────────────────────────────────────────────
# OS / Editor files
# ──────────────────────────────────────────────
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
*.swp
*.swo
*~
.idea/
.vscode/
*.code-workspace
*.sublime-workspace
*.sublime-project

# ──────────────────────────────────────────────
# Security – private keys & certificates
# ──────────────────────────────────────────────
*.pem
*.key
*.p12
*.pfx

# ──────────────────────────────────────────────
# AI agent / Antigravity / Gemini state
# ──────────────────────────────────────────────
.gemini/
.antigravity/
.agents/

# ──────────────────────────────────────────────
# Miscellaneous
# ──────────────────────────────────────────────
*.tgz
.cache/
tmp/
temp/
