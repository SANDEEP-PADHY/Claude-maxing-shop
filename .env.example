# ──────────────────────────────────────────────────────
# claudemaxing.shop – Environment Configuration
# ──────────────────────────────────────────────────────
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────────────

# ─── Database ────────────────────────────────────────
# SQLite for local development:
DATABASE_URL="file:./dev.db"
# PostgreSQL for production:
# DATABASE_URL="postgresql://user:password@host:5432/claudemaxing?schema=public"

# ─── Authentication ──────────────────────────────────
# Secret for signing session JWT tokens.
# Generate a random 32+ character string:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# ─── Cashfree Payment Gateway ────────────────────────
# Obtain from Cashfree Merchant Dashboard → Payment Gateway → API Keys
CASHFREE_CLIENT_ID=""
CASHFREE_CLIENT_SECRET=""
CASHFREE_ENV="sandbox"  # "sandbox" or "production"

# ─── Application URL ────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Merchant Identity ───────────────────────────────
MERCHANT_NAME="claudemaxing.shop"
MERCHANT_EMAIL="support@claudemaxing.shop"
MERCHANT_PHONE="+91 96646 50235"
MERCHANT_ADDRESS="India"
# Optional: only shown if configured; never fabricate
MERCHANT_GSTIN=""
MERCHANT_PAN=""

# ─── Plan Pricing (INR) ─────────────────────────────
PLAN_MAX_5X_PRICE=999
PLAN_MAX_20X_PRICE=1999

# ─── Database Seeding ───────────────────────────────
# These are ONLY used by `npx prisma db seed`.
# Set once for initial admin creation, then remove.
ADMIN_SEED_EMAIL="admin@claudemaxing.shop"
ADMIN_SEED_PASSWORD=""
ADMIN_SEED_PHONE=""
