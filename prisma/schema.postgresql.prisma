generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String          @id @default(cuid())
  name              String
  email             String          @unique
  phone             String          @unique
  password_hash     String
  role              String          @default("customer")
  email_verified_at DateTime?
  phone_verified_at DateTime?
  created_at        DateTime        @default(now())
  updated_at        DateTime        @updatedAt

  orders            Order[]
  subscriptions     Subscription[]
  access_assignments AccessAssignment[]
  support_tickets   SupportTicket[]
  audit_logs        AuditLog[]

  @@map("users")
}

model Plan {
  id             String         @id @default(cuid())
  name           String
  slug           String         @unique
  provider       String         @default("anthropic")
  multiplier     Int
  price          Int
  currency       String         @default("INR")
  billing_period String         @default("monthly")
  description    String
  features       String
  active         Boolean        @default(true)
  created_at     DateTime       @default(now())
  updated_at     DateTime       @updatedAt

  orders            Order[]
  subscriptions     Subscription[]
  access_keys       AccessKey[]
  access_assignments AccessAssignment[]

  @@map("plans")
}

model Order {
  id                 String         @id
  user_id            String
  plan_id            String
  cashfree_order_id  String?        @unique
  amount             Int
  currency           String         @default("INR")
  status             String         @default("CREATED")
  payment_status     String         @default("PENDING")
  
  delivery_method    String         @default("EMAIL")
  delivery_status    String         @default("PENDING")
  delivery_recipient String?
  access_key_id      String?
  delivered_at       DateTime?
  
  created_at         DateTime       @default(now())
  updated_at         DateTime       @updatedAt

  user               User           @relation(fields: [user_id], references: [id], onDelete: Cascade)
  plan               Plan           @relation(fields: [plan_id], references: [id])
  access_key         AccessKey?     @relation(fields: [access_key_id], references: [id])
  payments           Payment[]
  subscriptions      Subscription[]
  assignments        AccessAssignment[]
  support_tickets    SupportTicket[]

  @@map("orders")
}

model AccessKey {
  id                 String             @id @default(cuid())
  key_value_encrypted String
  plan_id            String
  status             String             @default("ACTIVE")
  max_customers      Int                @default(10)
  current_customers  Int                @default(0)
  created_at         DateTime           @default(now())
  updated_at         DateTime           @updatedAt

  plan               Plan               @relation(fields: [plan_id], references: [id])
  orders             Order[]
  assignments        AccessAssignment[]

  @@map("access_keys")
}

model AccessAssignment {
  id            String    @id @default(cuid())
  user_id       String
  order_id      String
  access_key_id String
  plan_id       String
  status        String    @default("ACTIVE")
  assigned_at   DateTime  @default(now())
  expires_at    DateTime
  delivered_at  DateTime?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  user          User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  order         Order     @relation(fields: [order_id], references: [id], onDelete: Cascade)
  access_key    AccessKey @relation(fields: [access_key_id], references: [id])
  plan          Plan      @relation(fields: [plan_id], references: [id])

  @@map("access_assignments")
}

model Payment {
  id                  String   @id @default(cuid())
  order_id            String
  cashfree_payment_id String?  @unique
  status              String
  amount              Int
  method              String?
  raw_reference       String?
  created_at          DateTime @default(now())

  order               Order    @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@map("payments")
}

model Subscription {
  id                 String    @id @default(cuid())
  user_id            String
  order_id           String
  plan_id            String
  provider           String    @default("anthropic")
  provider_reference String?
  starts_at          DateTime
  expires_at         DateTime
  status             String    @default("PENDING")
  fulfilment_status  String    @default("FULFILMENT_PENDING")
  activation_details String?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  user               User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  order              Order     @relation(fields: [order_id], references: [id], onDelete: Cascade)
  plan               Plan      @relation(fields: [plan_id], references: [id])

  @@map("subscriptions")
}

model SupportTicket {
  id         String   @id @default(cuid())
  user_id    String?
  order_id   String?
  name       String?
  email      String
  category   String
  subject    String
  message    String
  status     String   @default("OPEN")
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user       User?    @relation(fields: [user_id], references: [id], onDelete: SetNull)
  order      Order?   @relation(fields: [order_id], references: [id], onDelete: SetNull)

  @@map("support_tickets")
}

model AuditLog {
  id          String   @id @default(cuid())
  user_id     String?
  action      String
  entity_type String
  entity_id   String?
  metadata    String?
  created_at  DateTime @default(now())

  user        User?    @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}
